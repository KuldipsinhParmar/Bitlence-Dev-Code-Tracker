{
    "name": "kuldip8213/bitlence-dev-code-tracker",
    "description": "Dev-only test dependencies for Bitlence Dev Code Tracker. Not required to run the plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "^6",
        "johnpbloch/wordpress-core": "^6"
    },
    "config": {
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
